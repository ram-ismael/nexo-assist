# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL (Neon in production; any Postgres 15+ locally).
# Use the *pooled* Neon connection string on Vercel.
DATABASE_URL=postgres://user:password@localhost:5432/nexo_assist
DATABASE_POOL_MAX=5

# Demo login: known seeded e-mails sign in with any non-empty password.
# Synthetic data only. Replace with SSO/OIDC before using real employee data.
DEMO_AUTH_ENABLED=true

# LLM (Anthropic through Mastra's model router). Server-side only.
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5-5
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=45000

# Service desk calendar used by the SLA engine.
BUSINESS_TIMEZONE=America/Sao_Paulo
BUSINESS_DAY_START=8
BUSINESS_DAY_END=18
# Comma-separated YYYY-MM-DD dates. Empty = no holidays configured.
BUSINESS_HOLIDAYS=

# PRD: at most 30 employee messages answered by the agent per session.
AGENT_SESSION_MESSAGE_LIMIT=30

# Abuse and cost controls (stored in Postgres, shared by all instances).
RATE_LIMIT_TURNS_PER_MINUTE=8
RATE_LIMIT_TURNS_PER_DAY=150
RATE_LIMIT_LOGINS_PER_10MIN=20
LLM_GLOBAL_DAILY_TURNS=1500

# Development/test only. Both are refused when running on Vercel.
# Fraction (0-1) of ticket-service calls that fail, to exercise retries.
TICKET_FAULT_RATE=0
# Deterministic scripted model for CI and Playwright (no LLM calls).
NEXO_SCRIPTED_MODEL=false
